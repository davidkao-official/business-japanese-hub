{
  "name": "business-japanese-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:library": "vite",
    "dev:career-game": "vite --config vite.career-game.config.ts",
    "build": "pnpm workflow:verify-releases && pnpm typecheck && pnpm build:library && pnpm build:career-game",
    "build:library": "vite build",
    "build:career-game": "vite build --config vite.career-game.config.ts",
    "preview": "vite preview",
    "preview:library": "vite preview",
    "preview:career-game": "vite preview --config vite.career-game.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "workflow:validate": "tsx scripts/validate.ts",
    "workflow:preview": "tsx scripts/preview.ts",
    "workflow:publish": "tsx scripts/publish.ts",
    "workflow:verify-releases": "tsx scripts/verify-releases.ts && tsx scripts/verify-learning-catalog.ts",
    "workflow:update-learning-catalog": "tsx scripts/update-learning-catalog.ts",
    "workflow:verify-learning-catalog": "tsx scripts/verify-learning-catalog.ts",
    "workflow:rollback": "tsx scripts/rollback.ts"
  },
  "dependencies": {
    "@business-japanese-hub/career-game": "workspace:*",
    "@business-japanese-hub/learning": "workspace:*",
    "@business-japanese-hub/platform-auth": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
